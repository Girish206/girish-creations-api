generator client {
  provider = "prisma-client-js"
}

// MongoDB connector: Prisma 7 doesn't support MongoDB yet, so this stays on
// Prisma 6. Two connector limitations shape the models below:
//  - no autoincrement(): numeric ids are assigned from a "counters"
//    collection by the client extension in src/lib/prisma.ts, keeping the
//    same numeric ids (and URLs) the MySQL version had. The @default(0) on
//    each id only makes it optional in the generated types — the extension
//    always replaces it before writing.
//  - no Decimal: money/grade/experience values are stored as decimal
//    strings ("45.50"), which is exactly how the API already serialized them.
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// One portfolio per admin account: each login with portfolio access edits
// its own profile, and visitors reach it at /<username> on the public site.
model UserProfile {
  id                BigInt   @id @default(0) @map("_id")
  // URL handle for the public portfolio (/<username>). Optional (as is
  // adminUserId) only because the original single profile predates it —
  // prisma/link-profiles.ts backfills both, and every profile created since
  // gets them (profile.service.ts getOrCreateOwnProfile).
  username          String?  @unique
  fullName          String   @map("full_name")
  email             String
  bio               String?
  objective         String?
  // "/api/files/<id>" path of a StoredFile (see bottom of this file).
  profilePicture    String?  @map("profile_picture")
  signature         String?
  contactNumber     String?  @map("contact_number")
  // Whether visitors see contactNumber on the public portfolio. Null on
  // profiles saved before the setting existed, which means shown.
  showContactNumber Boolean? @map("show_contact_number")
  address           String?
  totalExperience   String   @default("0.00") @map("total_experience")
  facebookId        String?  @map("facebook_id")
  instaId           String?  @map("insta_id")
  linkedinId        String?  @map("linkedin_id")
  twitterId         String?  @map("twitter_id")
  // "/api/files/<id>" path of an uploaded PDF, or a static path for the
  // original site's bundled résumé.
  resume            String?
  // Which public design the portfolio uses: "tech" (developer look —
  // terminal, tech stack, monospace accents) or "classic" (plain, editorial
  // look for non-technical people). Null on profiles saved before the choice
  // existed, which means "tech".
  portfolioStyle    String?  @map("portfolio_style")
  // Colour shade of the classic design: "emerald", "ocean", "indigo",
  // "rose", "sunset" or "violet". Null (or a retired shade name) means
  // "emerald". Unused by the tech design.
  portfolioAccent   String?  @map("portfolio_accent")

  adminUserId BigInt?    @unique @map("admin_user_id")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  experienceDetails ExperienceDetails[]
  educationDetails  EducationDetails[]
  certifications    CertificationDetails[]
  skills            Skill[]
  tools             Tool[]
  contactMessages   ContactMessage[]
  blogPosts         BlogPost[]
  projects          ProjectDetails[]

  @@map("user_profiles")
}

model ExperienceDetails {
  id          BigInt    @id @default(0) @map("_id")
  jobTitle    String    @map("job_title")
  companyName String    @map("company_name")
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("experience_details")
}

model EducationDetails {
  id              BigInt    @id @default(0) @map("_id")
  course          String
  institutionName String    @map("institution_name")
  specialization  String?
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  grade           String

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("education_details")
}

model CertificationDetails {
  id                  BigInt    @id @default(0) @map("_id")
  name                String
  issuingOrganization String    @map("issuing_organization")
  issueDate           DateTime  @map("issue_date")
  expirationDate      DateTime? @map("expiration_date")
  credentialId        String?   @map("credential_id")
  credentialUrl       String?   @map("credential_url")

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("certification_details")
}

model Skill {
  id               BigInt @id @default(0) @map("_id")
  skillName        String @map("skill_name")
  proficiencyLevel String @map("proficiency_level")

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("skills")
}

model Tool {
  id       BigInt @id @default(0) @map("_id")
  toolName String @map("tool_name")

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("tools")
}

model ContactMessage {
  id      BigInt   @id @default(0) @map("_id")
  name    String
  email   String
  subject String
  message String
  sentAt  DateTime @default(now()) @map("sent_at")

  userProfileId BigInt?      @map("user_profile_id")
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("contact_messages")
}

model BlogPost {
  id            BigInt   @id @default(0) @map("_id")
  title         String
  slug          String   @unique
  content       String
  publishedDate DateTime @default(now()) @map("published_date")
  tags          String?

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("blog_posts")
}

model ProjectDetails {
  id               BigInt    @id @default(0) @map("_id")
  title            String
  description      String
  technologiesUsed String    @map("technologies_used")
  projectUrl       String?   @map("project_url")
  image            String?
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")

  userProfileId BigInt      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([userProfileId])
  @@map("projects")
}

model AdminUser {
  id                   BigInt   @id @default(0) @map("_id")
  // Both nullable: a "guest" member (added to appear in expense-split /
  // savings-holder pickers) has neither — they exist only to be listed.
  // Setting both later ("granting login access") promotes them to a
  // full account without needing a separate person/member table.
  email                String?  @unique
  // Digits only (utils/mobile.ts). An alternative login to email, and what
  // links an account to its cricket player (same number). Unique, checked
  // in admin-user.service.ts — no index, since most accounts have none.
  mobile               String?
  passwordHash         String?  @map("password_hash")
  name                 String?
  isOwner              Boolean  @default(false) @map("is_owner")
  // Super admins see every account's data in the admin panel (all expenses
  // and savings, and any portfolio via the portfolio picker) and manage
  // accounts. The owner always counts as one; only the owner grants it.
  isSuperAdmin         Boolean  @default(false) @map("is_super_admin")
  // Who added this person. A member without super admin manages only the
  // people they added themselves (Money Hub → Members).
  createdByAdminUserId BigInt?  @map("created_by_admin_user_id")
  isActive             Boolean  @default(true) @map("is_active")
  hasPortfolioAccess   Boolean  @default(true) @map("has_portfolio_access")
  // Independent per-section access within the expense-tracker module —
  // e.g. someone can be given Savings only, without Expenses.
  hasExpensesAccess    Boolean  @default(false) @map("has_expenses_access")
  hasSavingsAccess     Boolean  @default(false) @map("has_savings_access")
  // Player access to the Cricket module: their own stats, matches and
  // tournaments. Managing cricket needs super admin.
  hasCricketAccess     Boolean  @default(false) @map("has_cricket_access")
  // Bumped by "Sign out everywhere" (and when a login is reset): tokens
  // carry the version they were issued at, and CricDesk refuses older ones.
  // Null = 0 (accounts made before it existed).
  sessionVersion       Int?     @map("session_version")
  createdAt            DateTime @default(now()) @map("created_at")

  portfolioProfile        UserProfile?
  expensesPaid            Expense[]                 @relation("ExpensePaidBy")
  savingsContributions    SavingsContribution[]     @relation("SavingsContributionBy")
  savingsAccountsHeld     SavingsGoal[]             @relation("SavingsAccountHolder")
  savingsGoalsCreated     SavingsGoal[]             @relation("SavingsGoalCreatedBy")
  expenseSplitShares      ExpenseSplitParticipant[]
  savingsGoalMemberships  SavingsGoalMember[]
  expenseGroupMemberships ExpenseGroupMember[]
  expensesCreated         Expense[]                 @relation("ExpenseCreatedBy")
  settlementsPaid         ExpenseGroupSettlement[]  @relation("SettlementFrom")
  settlementsReceived     ExpenseGroupSettlement[]  @relation("SettlementTo")

  @@map("admin_users")
}

model ExpenseCategory {
  id        BigInt   @id @default(0) @map("_id")
  name      String   @unique
  // How the category is drawn: "icon" (a Font Awesome class in `icon`),
  // "text" (a short label/emoji in `icon`) or "image" (an uploaded file's
  // /api/files/<id> path in `icon`). Null on older rows — the client then
  // falls back to an icon suggested from the name.
  iconType  String?  @map("icon_type")
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@map("expense_categories")
}

// A trip/event bucket ("Goa Trip 2026") — unlike ExpenseCategory, names
// aren't unique since trips are one-off and names can legitimately repeat.
model ExpenseGroup {
  id        BigInt    @id @default(0) @map("_id")
  name      String
  // Optional trip window — when set, every expense in the group must be
  // dated within it (inclusive), enforced in expense.service.ts.
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  // Set once the trip is over and everyone has settled up — a closed group
  // can't take new expenses (or edits to its existing ones) until reopened.
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  expenses    Expense[]
  settlements ExpenseGroupSettlement[]
  members     ExpenseGroupMember[]

  @@map("expense_groups")
}

// The people on a trip/event ("Goa Trip 2026": Girish, Ravi, Asha). An
// expense in the group can be marked as paid by any of them. No rows = an
// older group from before members existed; its expenses are paid by
// whoever logs them.
model ExpenseGroupMember {
  id BigInt @id @default(0) @map("_id")

  expenseGroupId BigInt       @map("expense_group_id")
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)

  adminUserId BigInt    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@unique([expenseGroupId, adminUserId])
  @@index([adminUserId])
  @@map("expense_group_members")
}

// A repayment between two members to settle a group's split balances —
// "Ravi paid Girish back ₹1,200 for the Goa trip". Balances are derived
// (paid − share ± settlements), so these are the only stored part.
model ExpenseGroupSettlement {
  id        BigInt   @id @default(0) @map("_id")
  amount    String
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  expenseGroupId BigInt       @map("expense_group_id")
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)

  fromAdminUserId BigInt    @map("from_admin_user_id")
  fromAdminUser   AdminUser @relation("SettlementFrom", fields: [fromAdminUserId], references: [id])

  toAdminUserId BigInt    @map("to_admin_user_id")
  toAdminUser   AdminUser @relation("SettlementTo", fields: [toAdminUserId], references: [id])

  @@index([expenseGroupId])
  @@index([fromAdminUserId])
  @@index([toAdminUserId])
  @@map("expense_group_settlements")
}

model Expense {
  id          BigInt   @id @default(0) @map("_id")
  amount      String
  date        DateTime
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  categoryId BigInt          @map("category_id")
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  paidByAdminUserId BigInt    @map("paid_by_admin_user_id")
  paidBy            AdminUser @relation("ExpensePaidBy", fields: [paidByAdminUserId], references: [id])

  // Who logged it — usually the payer, but someone can log an expense a
  // fellow group member paid, and should still see it afterwards. Null on
  // expenses logged before this was recorded (the payer logged those).
  createdByAdminUserId BigInt?    @map("created_by_admin_user_id")
  createdBy            AdminUser? @relation("ExpenseCreatedBy", fields: [createdByAdminUserId], references: [id])

  // Which savings pot this expense was spent from — optional so existing/
  // ad-hoc expenses aren't forced to have one, but the intent is that most
  // expenses here are drawn down from a tracked savings account.
  savingsGoalId BigInt?      @map("savings_goal_id")
  savingsGoal   SavingsGoal? @relation(fields: [savingsGoalId], references: [id])

  // Ad-hoc bucket for a set of related expenses — e.g. "Goa Trip 2026" —
  // so they can be viewed and totalled together. Optional; unrelated to
  // ExpenseCategory (a taxonomy) which every expense still has.
  expenseGroupId BigInt?       @map("expense_group_id")
  expenseGroup   ExpenseGroup? @relation(fields: [expenseGroupId], references: [id])

  splitParticipants ExpenseSplitParticipant[]

  @@index([categoryId])
  @@index([paidByAdminUserId])
  @@index([savingsGoalId])
  @@index([expenseGroupId])
  @@map("expenses")
}

// Equal-split participants for an expense (e.g. a trip cost split among a
// subset of members). Absence of any rows here means the expense isn't
// split — it's just attributed to paidBy in full.
model ExpenseSplitParticipant {
  id          BigInt   @id @default(0) @map("_id")
  shareAmount String   @map("share_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  expenseId BigInt  @map("expense_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  adminUserId BigInt    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@unique([expenseId, adminUserId])
  @@index([adminUserId])
  @@map("expense_split_participants")
}

model SavingsGoal {
  id           BigInt    @id @default(0) @map("_id")
  name         String
  // Optional: a goal can either target a specific amount (shows a progress
  // bar) or be open-ended (e.g. "just saving ₹5000/month, no fixed total"),
  // in which case it just shows a running total of contributions.
  targetAmount String?   @map("target_amount")
  targetDate   DateTime? @map("target_date")
  // Where the money physically sits, and who holds that account.
  bankName     String?   @map("bank_name")
  // Set when the goal is done (reached, withdrawn, abandoned) — a closed
  // goal takes no more contributions and drops out of the "Spent From"
  // picker, but keeps its history.
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  accountHolderAdminUserId BigInt?    @map("account_holder_admin_user_id")
  accountHolder            AdminUser? @relation("SavingsAccountHolder", fields: [accountHolderAdminUserId], references: [id])

  // Who created this goal — private to them (and the account holder) by
  // default, same as an Expense is private to whoever paid it. Nullable so
  // existing rows (created before this column existed) don't suddenly lose
  // visibility for everyone; only newly created goals get this set.
  createdByAdminUserId BigInt?    @map("created_by_admin_user_id")
  createdBy            AdminUser? @relation("SavingsGoalCreatedBy", fields: [createdByAdminUserId], references: [id])

  contributions SavingsContribution[]
  expenses      Expense[]
  members       SavingsGoalMember[]

  @@index([accountHolderAdminUserId])
  @@map("savings_goals")
}

// Restricts a goal to specific people. No rows for a goal = visible to
// everyone with Savings access (the default, back-compatible behavior);
// any rows = only those members (plus the owner) can see/use that goal.
model SavingsGoalMember {
  id BigInt @id @default(0) @map("_id")

  savingsGoalId BigInt      @map("savings_goal_id")
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  adminUserId BigInt    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@unique([savingsGoalId, adminUserId])
  @@index([adminUserId])
  @@map("savings_goal_members")
}

model SavingsContribution {
  id        BigInt   @id @default(0) @map("_id")
  amount    String
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  goalId BigInt      @map("goal_id")
  goal   SavingsGoal @relation(fields: [goalId], references: [id])

  contributedByAdminUserId BigInt    @map("contributed_by_admin_user_id")
  contributedBy            AdminUser @relation("SavingsContributionBy", fields: [contributedByAdminUserId], references: [id])

  @@index([goalId])
  @@index([contributedByAdminUserId])
  @@map("savings_contributions")
}

// Uploaded images (profile picture, signature, project images) stored in
// the database itself as binary, served by GET /api/files/:id. Records that
// reference one hold its "/api/files/<id>" path rather than a FK, so the
// client can use the value directly as an <img src>.
model StoredFile {
  id          BigInt   @id @default(0) @map("_id")
  filename    String
  contentType String   @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("files")
}

// ===== Cricket tournaments (super admins only) =====

// The pool of people who can be picked for a tournament's teams.
model CricketPlayer {
  id        BigInt   @id @default(0) @map("_id")
  name      String
  // Digits only (utils/mobile.ts), unique among players. Required for new
  // players; it's also how a player's login account is found (an AdminUser
  // with the same mobile).
  mobile    String?
  // "batter", "bowler", "all-rounder" or "wicket-keeper"; null = not set.
  role      String?
  // Profile photo, as an /api/files/<id> path.
  photoUrl  String?  @map("photo_url")
  // Six digits an organiser shares with a player they added, which the
  // player enters to claim the record (set their password) on sign-up, so
  // knowing someone's number isn't enough. Cleared once claimed; made on
  // demand (null = none issued).
  inviteCode String? @map("invite_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cricket_players")
}

// Who a player follows: another player, a tournament, or one team in a
// tournament. Following a tournament (or one of its teams) also lets a
// player open it read-only.
model CricketFollow {
  id         BigInt   @id @default(0) @map("_id")
  // The CricketPlayer doing the following.
  followerId BigInt   @map("follower_id")
  // "player", "team" or "tournament".
  kind       String
  // The followed player, or the tournament (a team's too).
  targetId   BigInt   @map("target_id")
  // Teams only: index into the tournament's teams; null otherwise.
  teamIndex  Int?     @map("team_index")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([followerId])
  @@index([kind, targetId])
  @@map("cricket_follows")
}

// A set of players the organiser judges to be of equal strength — one per
// team (2 for two teams, 3 for three). Generating teams deals each set's
// players out to different teams at random, so every team gets one of each
// matched set. A set may be smaller than the team count (odd players left
// over); its players go to the teams with the fewest players.
type CricketMatchSet {
  playerIds BigInt[] @map("player_ids")
}

type CricketTeam {
  name          String
  playerIds     BigInt[] @map("player_ids")
  // Leadership, each one of playerIds (null = not picked). The keeper may
  // also be the captain or vice-captain; captain and vice-captain differ.
  captainId     BigInt?  @map("captain_id")
  viceCaptainId BigInt?  @map("vice_captain_id")
  keeperId      BigInt?  @map("keeper_id")
  // Built by hand or copied from another tournament (true), as opposed to
  // generated from matched sets (unset). Generating only fills the generated
  // teams and leaves these as they are.
  manual        Boolean?
}

// Teams and matched sets are embedded so a generate or a swap is a single
// atomic document write.
model CricketTournament {
  id              BigInt            @id @default(0) @map("_id")
  name            String
  // The squad: which players from the shared list take part. Only they can
  // be matched into sets.
  playerIds       BigInt[]          @map("player_ids")
  // One entry per team; the team count is teams.length. Players are empty
  // until teams are generated.
  teams           CricketTeam[]
  matchSets       CricketMatchSet[] @map("match_sets")
  // When the teams were last generated; null = not yet.
  generatedAt     DateTime?         @map("generated_at")
  // Details shown on the tournament and copied onto each new match (all
  // optional: tournaments made before these existed have none).
  // Uploaded images, as /api/files/<id> paths.
  logoUrl         String?           @map("logo_url")
  bannerUrl       String?           @map("banner_url")
  city            String?
  ground          String?
  organiserName   String?           @map("organiser_name")
  organiserMobile String?           @map("organiser_mobile")
  organiserEmail  String?           @map("organiser_email")
  startDate       DateTime?         @map("start_date")
  endDate         DateTime?         @map("end_date")
  // "open", "corporate", "community", "school", "other", "series",
  // "college" or "university".
  category        String?
  // "tennis", "leather" or "other".
  ballType        String?           @map("ball_type")
  // "rough", "cement", "turf", "astroturf" or "matting".
  pitchType       String?           @map("pitch_type")
  // "limited-overs", "box", "pair", "test" or "hundred".
  matchType       String?           @map("match_type")
  // Default overs per innings for its matches.
  overs           Int?
  // Default playing conditions for its matches (see CricketMatch); each
  // match starts with these and can change its own.
  ballsPerOver    Int?              @map("balls_per_over")
  bowlerOverLimit Int?              @map("bowler_over_limit")
  lastManStands   Boolean?          @map("last_man_stands")
  freeHit         Boolean?          @map("free_hit")
  // How it's played: its phases (league, groups, super league, playoffs,
  // series) as the client's CricketFormat, checked by cricket-format.ts.
  // Null = not set up (every match counts towards one points table).
  format          Json?
  // Players the organiser lets score (and edit) every match in it.
  scorerIds       BigInt[]          @map("scorer_ids")
  // Co-organisers (players): they manage it just like its creator.
  organiserIds    BigInt[]          @map("organiser_ids")
  // When the organiser marked it finished (null = still on, or decided by
  // its dates).
  finishedAt      DateTime?         @map("finished_at")
  // Anyone with the link can see it (and its matches) without signing in.
  isPublic        Boolean?          @map("is_public")
  // Bumped on every write of its teams, so two people editing at once
  // can't silently overwrite each other (null = 0).
  version         Int?
  // The account that created it; it (and super admins) manage it. Null for
  // tournaments made before this existed (super admins only).
  createdById     BigInt?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("cricket_tournaments")
}

// One delivery. batterId / nonStrikerId / bowlerId are who was in place
// when it was bowled, which is also what undoing it restores.
type CricketBall {
  batterId     BigInt  @map("batter_id")
  nonStrikerId BigInt  @map("non_striker_id")
  bowlerId     BigInt  @map("bowler_id")
  // Runs off the bat.
  runs         Int
  // "wide", "no-ball", "bye" or "leg-bye"; null = none.
  extraType    String? @map("extra_type")
  // Extra runs on this ball: a wide or no-ball counts its 1-run penalty
  // plus anything run; byes/leg-byes are the runs run.
  extras       Int
  // How the batter left (WICKET_TYPES in cricket.scoring.ts): "bowled",
  // "caught", "caught-behind", "lbw", "run-out", "stumped", ... Retired hurt,
  // retired and absent hurt aren't wickets. Null = none.
  wicketType   String? @map("wicket_type")
  dismissedId  BigInt? @map("dismissed_id")
  // Catcher, run-out thrower or wicket-keeper.
  fielderId    BigInt? @map("fielder_id")
  // A run-out's second fielder (the one who broke the stumps), when two
  // were involved; null otherwise.
  secondFielderId BigInt? @map("second_fielder_id")
  // An event between deliveries (a retirement, a Mankad, a timed out): no
  // ball bowled, so it counts for no batter, bowler or over. Null = a ball.
  noDelivery   Boolean? @map("no_delivery")
  // Where the shot went, when the scorer marks it on the ground: x / y from
  // -1 to 1 with the pitch at the centre, the bowler's end up and (for a
  // right-hander) the off side to the right. shotZone is the fielding
  // position it lands in ("Cover", "Deep mid wicket", ...). Null = not marked.
  shotX        Float?  @map("shot_x")
  shotY        Float?  @map("shot_y")
  shotZone     String? @map("shot_zone")
  // When it was recorded (null on older balls).
  at           DateTime?
  // Runs the batters ran off a no-ball that weren't hit: "bye" or
  // "leg-bye" (they're extras, not the batter's). Null = off the bat.
  byeType      String?  @map("bye_type")
  // A run-out's end: "striker" or "non-striker" — where the wicket was
  // broken, so the survivor is put at the other end. Null = worked out
  // from the runs (older balls).
  outEnd       String?  @map("out_end")
  // A 4 or 6 that reached the boundary (false = all run). Null on older
  // balls: then 4s and 6s count as boundaries.
  boundary     Boolean?
}

type CricketInnings {
  // 0 or 1: index into the match's teams.
  battingTeam  Int           @map("batting_team")
  // Who's in now; null while waiting for the scorer to pick (a new batter
  // after a wicket, a new bowler after an over).
  strikerId    BigInt?       @map("striker_id")
  nonStrikerId BigInt?       @map("non_striker_id")
  bowlerId     BigInt?       @map("bowler_id")
  closed       Boolean       @default(false)
  // When it was closed (null while in progress, and on older innings). It
  // started with its first ball's `at`.
  closedAt     DateTime?     @map("closed_at")
  balls        CricketBall[]
}

// A playing side in a match — a snapshot of the tournament team's name plus
// the playing XI chosen for this match.
type CricketMatchTeam {
  // Which tournament team this is (index into the tournament's teams), for
  // the points table; a standalone match's sides are just 0 and 1.
  teamIndex     Int      @map("team_index")
  name          String
  playerIds     BigInt[] @map("player_ids")
  // This match's leaders, from its playing XI: copied from the tournament
  // team, and changeable when the match starts.
  captainId     BigInt?  @map("captain_id")
  viceCaptainId BigInt?  @map("vice_captain_id")
  keeperId      BigInt?  @map("keeper_id")
  // Which team a standalone match's side is, so matches of the same team
  // share its players even when two different teams have the same name:
  // "t:<tournamentId>:<teamIndex>" for a tournament team, "f:<uuid>" for a
  // friendly team. Null on tournament matches and older one-offs; see
  // effectiveTeamKey.
  teamKey       String?  @map("team_key")
}

model CricketMatch {
  id              BigInt             @id @default(0) @map("_id")
  // Null for a standalone match, outside any tournament.
  tournamentId    BigInt?            @map("tournament_id")
  // Exactly two.
  teams           CricketMatchTeam[]
  // Overs per innings.
  overs           Int
  scheduledAt     DateTime?          @map("scheduled_at")
  // The ground; city is kept apart so it can be shown as "ground, city".
  venue           String?
  city            String?
  // Same values as on the tournament, which they're filled in from.
  matchType       String?            @map("match_type")
  ballType        String?            @map("ball_type")
  pitchType       String?            @map("pitch_type")
  // The round: "league", "group", "quarter-final", "final", ... (see
  // MATCH_STAGES in cricket-match.controller.ts); null = league.
  stage           String?
  // Its place in the tournament's format: the phase's id, its group ("A")
  // and its knockout or series slot ("Q1", "F", "M2"). Null on matches
  // scheduled by hand.
  phaseId         String?            @map("phase_id")
  group           String?
  slot            String?
  // "scheduled", "live", "completed" or "abandoned".
  status          String             @default("scheduled")
  // 0 or 1 (index into teams); null until the toss.
  tossWinner      Int?               @map("toss_winner")
  // "bat" or "bowl".
  tossDecision    String?            @map("toss_decision")
  innings         CricketInnings[]
  // 0 or 1 when completed with a winner; null for a tie or no result.
  winner          Int?
  resultText      String?            @map("result_text")
  // How a result entered by hand was decided: "super-over", "walkover",
  // "forfeit", "concede", "dls", "bowl-out" or "other". Null = played out.
  resultMethod    String?            @map("result_method")
  // The chasing side's target after a rain cut (null = first innings + 1).
  revisedTarget   Int?               @map("revised_target")
  // Balls in an over (null = 6; 5 for The Hundred).
  ballsPerOver    Int?               @map("balls_per_over")
  // Most overs one bowler may bowl (null = no limit).
  bowlerOverLimit Int?               @map("bowler_over_limit")
  // The last batter bats on alone (gully / box cricket).
  lastManStands   Boolean?           @map("last_man_stands")
  // A no-ball gives a free hit (null = yes; false = off).
  freeHit         Boolean?           @map("free_hit")
  // Anyone with the link can watch it without signing in.
  isPublic        Boolean?           @map("is_public")
  // Bumped on every score change: a write based on an older copy (another
  // phone, a retried request) is refused instead of overwriting (null = 0).
  version         Int?
  playerOfMatchId BigInt?            @map("player_of_match_id")
  // Players added to score (and edit) this match, along with its
  // organisers and both captains.
  scorerIds       BigInt[]           @map("scorer_ids")
  // Only one person scores at a time: the account holding the scorer (and
  // its name, to tell the others) and when it took it. It stays theirs
  // until they hand it over or stop (see claimScoring).
  scoringById     BigInt?            @map("scoring_by_id")
  scoringByName   String?            @map("scoring_by_name")
  scoringSeenAt   DateTime?          @map("scoring_seen_at")
  // The account that created it; it, the tournament's creator and super
  // admins manage it (score it too). Null for older matches.
  createdById     BigInt?            @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([tournamentId])
  @@map("cricket_matches")
}

// A team made outside any tournament ("Create team"): its name, players and
// leaders. One-off matches that pick it carry its teamKey ("f:<uuid>", like
// any friendly team), and their side starts with its players and leaders.
// Its creator, its captain and super admins manage it.
// A browser that asked for notifications (Web Push) for a CricDesk account:
// match starts and results of what they play in or follow.
model CricketPushSubscription {
  id        BigInt   @id @default(0) @map("_id")
  adminId   BigInt   @map("admin_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("cricket_push_subscriptions")
}

model CricketSavedTeam {
  id            BigInt   @id @default(0) @map("_id")
  teamKey       String   @map("team_key")
  name          String
  playerIds     BigInt[] @map("player_ids")
  captainId     BigInt?  @map("captain_id")
  viceCaptainId BigInt?  @map("vice_captain_id")
  keeperId      BigInt?  @map("keeper_id")
  createdById   BigInt   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("cricket_saved_teams")
}
