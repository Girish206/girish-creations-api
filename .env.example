# MongoDB Atlas connection string — must include the database name
# (the "/girishCreations" path segment).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/girishCreations?retryWrites=true&w=majority"
PORT=4000
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=90d
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
CORS_ORIGIN=http://localhost:5173
# CricDesk match notifications (Web Push). Generate a pair once with
# `npx web-push generate-vapid-keys`; leave empty to turn notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
