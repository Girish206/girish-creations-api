# MongoDB Atlas connection string — must include the database name
# (the "/girishCreations" path segment).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/girishCreations?retryWrites=true&w=majority"
PORT=4000
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=90d
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
CORS_ORIGIN=http://localhost:5173
# Email through ZeptoMail (Zoho). Leave the token empty to turn email off.
# Mail Agents > your agent > SMTP and API info gives the Send Mail token and
# the API host. The from address must be on a domain verified in ZeptoMail.
# Check the setup with: npm run email:test -- you@example.com
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Girish Creations
# The token only works in your account's region, otherwise you get "Invalid API
# Token found": use https://cpaas.zoho.in/v1.1/email for an India account.
ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email
# Where replies to our emails go (a contact form's message still replies to the
# visitor). Leave empty for runmithra@gmail.com.
ZEPTOMAIL_REPLY_TO=
# Where sign-in links in emails go. Leave empty for
# https://girish-creations.vercel.app/admin.
ADMIN_SIGN_IN_URL=
