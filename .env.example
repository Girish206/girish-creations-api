# MongoDB Atlas connection string — must include the database name
# (the "/girishCreations" path segment).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/girishCreations?retryWrites=true&w=majority"
PORT=4000
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
CORS_ORIGIN=http://localhost:5173
